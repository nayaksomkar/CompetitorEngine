# CompetitorEngine — pure orchestrator configuration.
#
# Required: both upstream service URLs must be set, or the app
# refuses to start.

# Reasoning service (LLMPing) — does all AI work
LLMPING_URL=https://llmping.onrender.com
LLMPING_TIMEOUT=60
# LLMPING_API_KEY=

# Research service (WebHunter) — does all external research
WEBHUNTER_URL=https://webhunter-1v83.onrender.com
WEBHUNTER_TIMEOUT=30

# Service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
LOG_LEVEL=INFO

# CORS env override (also hardcoded in app/main.py as a fallback)
ALLOWED_ORIGINS=https://nayaksomkar.github.io,http://localhost:5173,http://localhost:3000
