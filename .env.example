# CompetitorEngine — pure orchestrator configuration.
#
# Service URLs
# ─────────────
# Two ways to run:
#
#   1. LOCAL DOCKER (recommended for development)
#      Leave both URLs unset (or set them to your local Docker hosts).
#      The orchestrator will auto-discover sibling containers at runtime
#      using these built-in candidates:
#        LLMPing:   host.docker.internal:8000 → llmping:8000 → localhost:8000
#        WebHunter: host.docker.internal:8765 → webhunter:8000 → localhost:8765
#
#   2. PRODUCTION (Render)
#      Set both URLs explicitly so the orchestrator talks directly to
#      the deployed upstreams and skips discovery probes entirely:
#        LLMPING_URL=https://llmping.onrender.com
#        WEBHUNTER_URL=https://webhunter-1v83.onrender.com
#
# The active URL for each service is always:
#   explicit URL → local Docker service name → host.docker.internal → localhost

# ── Local Docker mode (uncomment for host.docker.internal access) ──
# LLMPING_URL=http://host.docker.internal:8000
# WEBHUNTER_URL=http://host.docker.internal:8765

# ── Production mode (uncomment when deploying) ──
# LLMPING_URL=https://llmping.onrender.com
# WEBHUNTER_URL=https://webhunter-1v83.onrender.com

# Timeouts (seconds per request)
LLMPING_TIMEOUT=60
WEBHUNTER_TIMEOUT=30
# LLMPING_API_KEY=  (set if your LLMPing requires auth)

# Service binding
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
LOG_LEVEL=INFO

# CORS env override
ALLOWED_ORIGINS=https://nayaksomkar.github.io,http://localhost:5173,http://localhost:3000
